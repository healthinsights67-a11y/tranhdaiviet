{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/uploads/$1"
    },
    {
      "source": "/((?!api|uploads|zalo_verifier).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/zalo-reminders",
      "schedule": "30 1 * * *"
    }
  ]
}
