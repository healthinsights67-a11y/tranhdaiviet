{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/zalo-reminders",
      "schedule": "30 1 * * *"
    }
  ]
}
