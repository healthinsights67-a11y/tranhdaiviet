rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Other collections
    match /tasks/{docId} { allow read, write: if request.auth != null; }
    match /customers/{docId} { allow read, write: if request.auth != null; }
    match /orders/{docId} { allow read, write: if request.auth != null; }
    match /members/{docId} { allow read, write: if request.auth != null; }
    match /media_folders/{docId} { allow read, write: if request.auth != null; }
    match /media_library/{docId} { allow read, write: if request.auth != null; }
    match /quotations/{docId} { allow read, write: if request.auth != null; }
    match /measurement_schedules/{docId} { allow read, write: if request.auth != null; }
    match /product_library/{docId} { 
      allow read, write: if request.auth != null; 
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /configs/{docId} { 
      allow read: if request.auth != null; 
      allow write: if false; 
    }
    
    match /{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.token.email.matches('(?i)haanhtran.cv02@gmail.com') ||
        request.auth.uid == 'W93oNEMY3Jeef6S5FHnchqABvwy1' ||
        request.auth.token.email.matches('(?i)nhoanhkoem01@gmail.com')
      );
    }
  }
}
